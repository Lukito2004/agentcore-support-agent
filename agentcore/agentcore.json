{
  "name": "SupportAgent",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "support_agent",
      "modelProvider": "Bedrock",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/support_agent",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_j2xAGAHVM/.well-known/openid-configuration",
          "allowedClients": [
            "1cmf12kmhm73b170sp9re1rneh"
          ]
        }
      },
      "envVars": [
        {
          "name": "GUARDRAIL_ID",
          "value": "he2k0mepju88"
        },
        {
          "name": "GUARDRAIL_VERSION",
          "value": "3"
        }
      ],
      "additionalPolicies": [
        "arn:aws:iam::230858577630:policy/support-agent-apply-guardrail"
      ]
    }
  ],
  "memories": [
    {
      "name": "supportMemory",
      "description": "Per-customer preferences for the support agent",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "support-tools-oauth",
      "vendor": "CustomOauth2",
      "clientId": "6ldi8lqdj2mtguf1ifeehv660q",
      "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_j2xAGAHVM/.well-known/openid-configuration",
      "scopes": [
        "support-gateway/tools.invoke"
      ]
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "support-tools",
      "protocolType": "MCP",
      "description": "Business tools for the support agent",
      "targets": [
        {
          "name": "customer-orders",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:230858577630:function:SupportAgentBackend-ReadToolsFunctionA1A394D8-ke0aUbsxk1TG",
            "toolSchemaFile": "backend/tool_schemas/customer_orders.json"
          }
        },
        {
          "name": "refunds",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:230858577630:function:SupportAgentBackend-RefundToolFunction805A5991-fOc4fNsMopLU",
            "toolSchemaFile": "backend/tool_schemas/refunds.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_j2xAGAHVM/.well-known/openid-configuration",
          "allowedClients": [
            "6ldi8lqdj2mtguf1ifeehv660q"
          ],
          "allowedScopes": [
            "support-gateway/tools.invoke"
          ]
        }
      },
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "support_tools_policies",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "support_tools_policies",
      "description": "Authorization for support agent tool calls",
      "policies": [
        {
          "name": "allow_read_tools",
          "description": "Read-only tools are always allowed",
          "statement": "// Read-only tools are always allowed; the Lambda still checks the order belongs to the customer.\npermit (\n  principal,\n  action in [\n    AgentCore::Action::\"customer-orders___get_customer\",\n    AgentCore::Action::\"customer-orders___get_order_status\"\n  ],\n  resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:230858577630:gateway/supportagent-default-support-tools-heawf1kemt\"\n);\n",
          "sourceFile": "policies/allow_read_tools.cedar",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "limit_refunds",
          "description": "Refunds up to 1,000 USD",
          "statement": "// Refunds up to 1,000 USD only; amount_cents is set by the agent's code, not by the model.\n// A call without amount_cents, or above the limit, matches no permit and is denied by default.\npermit (\n  principal,\n  action == AgentCore::Action::\"refunds___refund_customer\",\n  resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:230858577630:gateway/supportagent-default-support-tools-heawf1kemt\"\n)\nwhen { context.input has amount_cents && context.input.amount_cents <= 100000 };\n",
          "sourceFile": "policies/limit_refunds.cedar",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "harnesses": []
}